#!/bin/sh
# runit entrypoint for the native Scheiber SwitchableOutput service.
exec 2>&1

APP_DIR="${APP_DIR:-/data/scheiber-gx}"
SERVICE_SCRIPT="${SERVICE_SCRIPT:-$APP_DIR/switch_service.py}"

saved_can_if=""
saved_bitrate=""
saved_tx=""
saved_rtr=""
[ -r "$APP_DIR/CAN_INTERFACE" ] && saved_can_if="$(cat "$APP_DIR/CAN_INTERFACE")"
[ -r "$APP_DIR/CAN_BITRATE" ] && saved_bitrate="$(cat "$APP_DIR/CAN_BITRATE")"
[ -r "$APP_DIR/SWITCH_TX_ENABLED" ] && saved_tx="$(cat "$APP_DIR/SWITCH_TX_ENABLED")"
[ -r "$APP_DIR/SWITCH_RTR_ENABLED" ] && saved_rtr="$(cat "$APP_DIR/SWITCH_RTR_ENABLED")"

CAN_IF="${CAN_IF:-${saved_can_if:-can2}}"
CAN_BITRATE="${CAN_BITRATE:-${saved_bitrate:-250000}}"
SWITCH_TX_ENABLED="${SWITCH_TX_ENABLED:-${saved_tx:-1}}"
SWITCH_RTR_ENABLED="${SWITCH_RTR_ENABLED:-${saved_rtr:-1}}"

modprobe can 2>/dev/null || true
modprobe can_raw 2>/dev/null || true
modprobe gs_usb 2>/dev/null || true

# The existing scheiber-gx service owns CAN setup. Wait for the shared interface
# rather than racing it during boot. runit retries this service if it stays absent.
attempt=0
while [ "$attempt" -lt 30 ]; do
    if ip link show "$CAN_IF" >/dev/null 2>&1 \
        && ip -details link show "$CAN_IF" 2>/dev/null | grep -q "bitrate $CAN_BITRATE" \
        && ip link show "$CAN_IF" 2>/dev/null | grep -q "UP"; then
        break
    fi
    attempt=$((attempt + 1))
    sleep 1
done

if [ "$attempt" -ge 30 ]; then
    echo "scheiber-switch: $CAN_IF was not ready at $CAN_BITRATE bit/s; retrying via runit"
    exit 1
fi

export CAN_IF SWITCH_TX_ENABLED SWITCH_RTR_ENABLED
exec python3 "$SERVICE_SCRIPT"
